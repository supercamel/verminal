{
  "schema_version": 2,
  "name": "Verminal",
  "app_id": "io.github.supercamel.Verminal",
  "icon": "images/io.github.supercamel.Verminal.png",
  "features": ["gtk4"],
  "target": "all",
  "compile_scripts": false,
  "desktop_terminal": false,
  "desktop_categories": ["Development", "Utility", "GTK"],
  "entry": {
    "type": "native",
    "project": "verminal",
    "executable": "verminal",
    "android": {
      "project": "verminal",
      "library": "libverminal.so",
      "symbol": "sqgi_android_main"
    }
  },
  "native": [
    {
      "name": "gserial",
      "linux_package": "gserial",
      "windows_package": "gserial",
      "android_package": "extras-gserial"
    },
    {
      "name": "verminal",
      "dir": ".",
      "build_system": "meson",
      "depends_on": ["gserial"]
    }
  ],
  "platforms": {
    "linux": {
      "architectures": ["x86_64", "aarch64"],
      "baseline": "ubuntu-24.04"
    },
    "windows": {"architectures": ["x86_64"], "format": "installer"},
    "android": {
      "architectures": ["arm64-v8a", "x86_64"],
      "sdk": "noble-android-r7",
      "format": "apk",
      "min_sdk": 31,
      "version_code": 3,
      "version_name": "0.3.0",
      "namespaces": ["Gtk-4.0", "GSerial-1.0"],
      "permissions": ["android.permission.INTERNET"]
    }
  },
  "windows": {
    "console": false,
    "nsis_options": {"icon": "images/verminal.ico"}
  }
}
